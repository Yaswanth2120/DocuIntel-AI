# scripts/setup_local.py generates random local secrets. Never use placeholders in production.
APP_ENV=development
POSTGRES_PASSWORD=replace-with-random-secret
APP_DB_PASSWORD=replace-with-different-random-secret
REDIS_PASSWORD=replace-with-different-random-secret
TENANT_API_KEYS={"replace-with-at-least-32-random-characters":{"tenant_id":"acme","role":"admin"},"another-random-reader-key-32-characters":{"tenant_id":"acme","role":"reader"}}
# Compose supplies these internally; set URLs when running on the host.
# DATABASE_URL=postgresql://docuintel_app:password@127.0.0.1:5432/docuintel
# REDIS_URL=redis://:password@127.0.0.1:6379/0
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.0
EMBEDDING_BACKEND=sentence_transformers
RERANKER_BACKEND=cross_encoder
GROUNDING_VERIFIER=nli
# Stronger NLI second opinion for rejected claims (nli|off); deliver supported sentences only (true|false)
GROUNDING_ESCALATION=nli
GROUNDING_PARTIAL_DELIVERY=true
# On refusal, salvage cited facts from a hedged answer (true|false)
GROUNDING_RECOVERY=true
# Then retry once with a rewritten search query; measured no gain with a 4B model (true|false)
GROUNDING_RETRY=false
# Decline answers whose citations all rank below this position (0 disables)
GROUNDING_MAX_CITED_RANK=7
RAG_DEFAULT_MODE=hybrid
RAG_DEFAULT_RERANK=true
RAG_CHUNK_SIZE=650
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=4
RAG_RELEVANCE_THRESHOLD=0.1
MAX_UPLOAD_BYTES=10485760
DB_POOL_SIZE=10
RETRIEVAL_CACHE_TTL=60
RATE_LIMIT=30/minute
CORS_ALLOW_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Optional cost estimates use actual provider-reported generation tokens.
# INPUT_USD_PER_MILLION=your-provider-input-price
# OUTPUT_USD_PER_MILLION=your-provider-output-price
# Legacy single-tenant local mode only:
# API_KEY=your-secret
# Optional tracing:
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=docuintel-ai

# Shared atomic tenant/document capacity limits:
MAX_TENANT_DOCUMENTS=10000
MAX_TENANT_BYTES=1073741824
MAX_TENANT_CHUNKS=200000
MAX_EXTRACTED_CHARS=2000000
MAX_DOCUMENT_CHUNKS=5000
RAG_MAX_CHUNKS_PER_DOCUMENT=2
MAX_OUTPUT_TOKENS=512
# Optional OpenAI-compatible private inference service:
# OPENAI_BASE_URL=https://your-inference-service/v1

# Operator-only global metrics credential (not a tenant API key):
METRICS_API_KEY=replace-with-another-32-character-random-secret

# Optional native-host inference override for Docker Desktop:
# DOCKER_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# MODEL_REASONING_EFFORT=none
